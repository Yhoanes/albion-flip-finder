<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_feed">

    <fragment
        android:id="@+id/navigation_feed"
        android:name="com.shadr.miflipperapp.FeedFragment"
        android:label="@string/nav_feed"
        tools:layout="@layout/fragment_feed" />

    <fragment
        android:id="@+id/navigation_watchlist"
        android:name="com.shadr.miflipperapp.WatchlistFragment"
        android:label="@string/nav_watchlist"
        tools:layout="@layout/fragment_watchlist" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.shadr.miflipperapp.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

